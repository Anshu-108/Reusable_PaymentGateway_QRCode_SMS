pipeline {
    agent any

    environment {
        // Adjust these paths to match your Windows install
        PHP_HOME = 'C:/wamp64/bin/php/php8.3.28'
        COMPOSER_HOME = 'C:/ProgramData/ComposerSetup/bin'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'composer install --no-interaction --prefer-dist --optimize-autoloader'
            }
        }

        stage('Set Up Environment') {
            steps {
                bat '''
                    if not exist .env (
                        copy .env.example .env
                    )
                    php artisan key:generate
                '''
            }
        }

        stage('Run Migrations') {
            steps {
                // Point this at a test/staging DB, not production, if running automatically
                bat 'php artisan migrate --force'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'php artisan test'
                // or: bat 'vendor\\bin\\phpunit'
            }
        }

        stage('Build Frontend Assets') {
            when {
                expression { fileExists('package.json') }
            }
            steps {
                bat 'npm install'
                bat 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                // Example: copy files to a local IIS/XAMPP www folder
                // bat 'xcopy /E /Y . C:\\inetpub\\wwwroot\\my-laravel-app'

                // Example: deploy to a remote server over SSH (requires SSH Agent plugin + credentials)
                // sshagent(['your-ssh-credential-id']) {
                //     bat 'scp -r . user@your-server:/var/www/my-laravel-app'
                // }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output above for details.'
        }
    }
}